{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "velocicode",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // velocicode.acmsa.org can't be attached until the acmsa.org zone moves
  // into this account; it'll be added in the dashboard then, so the deploy
  // token never needs zone permissions. Until then, serve from workers.dev.
  "workers_dev": true
}
