{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "velocicode",
  "compatibility_date": "2026-10-19",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "velocicode.acmsa.org", "custom_domain": true }],
  "workers_dev": false
}
